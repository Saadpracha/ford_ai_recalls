# Input recalls (Excel) and output CSV (utf-8-sig, saved after each extraction)
INPUT_RECALLS_FILE=Input_recalls_number.xlsx
OUTPUT_CSV_FILE=recalls_output_1.csv

# Ford portal country
FORD_COUNTRY=CAN (iproyal CSV)
# Login picks random IP; scrape runs reuse the same IP from ford_profile/proxy_session.json
USE_PROXY=true
PROXY_CSV_PATH=iproyal-proxies-10.csv
# New random IP + re-login: python main.py --login-only
# Fixed IP at login:       python main.py --login-only --proxy-index 0

# --- Google Sheets (optional, for later batch mode) ---
# SHEET_ID=
# GOOGLE_CREDENTIALS_PATH=credentials.json
# SHEET_NAME=Sheet1

# Playwright profile directory
FORD_PROFILE_DIR=./ford_profile

# Linux server: virtual X display (headless=False). Auto on when DISPLAY is unset.
# Requires: pip install pyvirtualdisplay && sudo apt install xvfb
# USE_VIRTUAL_DISPLAY=true

# Batch size per run
BATCH_SIZE=25

# Delay between recalls (seconds)
RECALL_DELAY=1.5

# Language to scrape: en (English only), fr (French only), or leave empty for both
# RECALL_LANG=en

# OpenAI — bulletin labour codes + owner letter parts availability
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
USE_OPENAI=true
